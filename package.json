{
  "name": "cesart-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run content:prepare && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "content:prepare": "tsx scripts/prepare-content.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:api": "node scripts/db-api-smoke.mjs",
    "db:import": "tsx scripts/import-to-supabase.mjs",
    "test:parity": "tsx scripts/parity-test.mjs",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:seed:check": "tsx scripts/generate-seed.ts && git diff --exit-code -- supabase/seed.sql supabase/tests/database/01_seed_matches_content.test.sql"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "marked": "^18.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "ffmpeg-static": "^5.3.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
