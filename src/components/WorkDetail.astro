---
import type { Category, Work } from '../lib/schema';
import MediaView from './MediaView.astro';

interface Props {
  work: Work;
  category?: Category;
  /** `page` renders the main heading as h1; `lightbox` uses h2. */
  variant?: 'page' | 'lightbox';
}

const { work, category, variant = 'page' } = Astro.props;
const Heading = variant === 'page' ? 'h1' : 'h2';
---

<article class="detail" data-work-slug={work.slug}>
  <div class="detail__media">
    <MediaView media={work.media} mode="detail" eager={variant === 'page'} sizes="(min-width: 1024px) 60vw, 100vw" />
  </div>
  <div class="detail__info">
    <Heading class="detail__title" id={variant === 'lightbox' ? 'lightbox-title' : undefined} tabindex={variant === 'lightbox' ? -1 : undefined}>{work.title}</Heading>
    <p class="eyebrow">{[category?.label, work.year].filter(Boolean).join(' · ')}</p>
    {work.description && <p class="detail__desc">{work.description}</p>}
    {
      work.tags.length > 0 && (
        <ul class="detail__tags" aria-label="Tags">
          {work.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
  </div>
  {
    work.gallery && work.gallery.length > 0 && (
      <div class="detail__gallery">
        {work.gallery.map((m) => (
          <MediaView media={m} mode="detail" sizes="(min-width: 1024px) 60vw, 100vw" />
        ))}
      </div>
    )
  }
</article>

<style is:global>
  .detail { display: grid; gap: var(--space-5); align-items: start; }
  .detail__media, .detail__gallery { display: grid; gap: var(--grid-gap); min-width: 0; }
  .detail__media .media, .detail__gallery .media { max-height: 82vh; max-width: 100%; margin-inline: auto; background: transparent; }
  .detail__title { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
  .detail__title:focus { outline: none; }
  .detail__desc { max-width: var(--measure); margin-top: var(--space-4); color: var(--color-muted); }
  .detail__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: var(--space-4) 0 0; }
  .detail__tags li { font-size: var(--text-xs); padding: var(--space-1) var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-pill); color: var(--color-muted); }
  @media (min-width: 1024px) {
    .detail { grid-template-columns: minmax(0, 1fr) 20rem; gap: var(--space-7); }
    .detail__gallery { grid-column: 1; }
    .detail__info { grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--header-height) + var(--space-5)); }
  }
</style>
