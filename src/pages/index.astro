---
import Base from '../layouts/Base.astro';
import { PageRoot, createRenderContext } from '../components/render/Shell';
import { url } from '../components/url';
import { getSnapshot } from '../lib/content';
import { resolvePageMedia } from '../lib/render-media';
import { pageSeo, publishedPages } from '../lib/render-model';

// The home page is served at / whatever its slug.
const snapshot = await getSnapshot();
const page = publishedPages(snapshot).find((p) => p.isHome)!;
const seo = pageSeo(snapshot, page);
const ctx = createRenderContext(snapshot, url(), await resolvePageMedia(page, snapshot.works), page);
---

<Base title={seo.title} description={seo.description} image={seo.image} page={page}>
  <PageRoot ctx={ctx} />
</Base>
