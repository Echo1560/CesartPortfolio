---
import '../styles/global.css';
import '../styles/site.css';
import { getSnapshot } from '../lib/content';
import { themeFontCss } from '../lib/fonts';
import { resolveMediaUrl } from '../lib/media';
import { themeToCss } from '../lib/theme-css';
import type { SnapshotPage } from '../lib/schema-v3';
import { createRenderContext, FooterRoot, HeaderRoot } from '../components/render/Shell';
import { url } from '../components/url';

interface Props {
  title?: string;
  description?: string;
  /** Bucket key (path relative to `content/media/`). Defaults to `meta.ogImage`. */
  image?: string;
  ogType?: 'website' | 'article';
  /** The page being rendered; undefined for work pages. Lets the header mark the current page and use same-page anchors. */
  page?: SnapshotPage;
  /** Work slug, set on detail pages for tracking. */
  workSlug?: string;
}

const snapshot = await getSnapshot();
const { meta } = snapshot.site;
const { title = meta.title, description = meta.description, image = meta.ogImage, ogType = 'website', page, workSlug } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(await resolveMediaUrl(image), Astro.site).href;
const ctx = createRenderContext(snapshot, url(), new Map(), page);
// The theme is validated by themeToCss (enums, numbers and #rrggbb colours only), so the CSS is safe to inline.
const themeCss = themeFontCss(snapshot.theme.tokens, url()) + themeToCss(snapshot.theme.tokens);
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={meta.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <style set:html={themeCss} id="theme-css"></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body id="top" data-work-slug={workSlug} data-page-slug={page?.slug}>
    <a class="skip-link" href="#main">Skip to content</a>
    <HeaderRoot ctx={ctx} />
    <main id="main">
      <slot />
    </main>
    <FooterRoot ctx={ctx} year={new Date().getFullYear()} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
