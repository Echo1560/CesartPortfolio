# Copy to .env (git-ignored). Never commit real values.
#
# Content source for the build (see docs/V2-CONTRACTS.md, "Data layer").
#   local    = read content/*.json (v1 behaviour, the default)
#   supabase = read the published snapshot from Supabase (fails the build if unreachable)
CONTENT_SOURCE=local

# Supabase project URL and anon (publishable) key. Safe for the browser: RLS
# decides what they can do. Local values come from `npx supabase status`.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=

# Video variants of animated GIF/WebP media (WebM + MP4 + poster), generated
# before `astro build` with ffmpeg (ffmpeg-static or PATH).
#   auto     = generate; warn and keep the original GIF if ffmpeg is missing (default)
#   required = fail the build without ffmpeg (the default when CI is set)
#   off      = skip
# MEDIA_VARIANTS=auto

# One-off import (`npm run db:import`): pass SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY in the SHELL environment for that one command only.
# Do NOT put the service-role key in this file: .env is loaded by every build.
# The import script does not read .env.

# Server-side secrets. ONLY in Supabase Edge Function secrets
# (`supabase secrets set`), never in GitHub Pages builds or the client bundle:
#   SUPABASE_SERVICE_ROLE_KEY   provided automatically to Edge Functions
#   GITHUB_DISPATCH_TOKEN       fine-grained token, repo Echo1560/CesartPortfolio, "Contents: read & write" (repository_dispatch)
#   PUBLISH_STATUS_TOKEN        random 32+ byte string; also a GitHub Actions secret (deploy workflow -> publish-status)
#   EVENTS_HASH_SECRET          random 32+ byte string used to derive the daily visitor-hash salt
